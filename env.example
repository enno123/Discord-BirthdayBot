# Discord bot token (from the Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Time of day the daily check runs (24h format, server time)
ANNOUNCE_HOUR=9
ANNOUNCE_MINUTE=0

# Optional: guild (server) ID for INSTANT slash command sync while testing on a single
# server. Leave empty for production across multiple servers -> commands sync globally
# (available everywhere, but can take up to ~1 hour to propagate).
GUILD_ID=

# --- MySQL database ---
# The bot creates the required tables automatically on first start.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=birthdaybot
DB_PASSWORD=your_db_password
DB_NAME=birthdaybot
